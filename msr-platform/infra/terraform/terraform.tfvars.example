# Copia este fichero a terraform.tfvars y ajústalo. terraform.tfvars NO se
# versiona (ver .gitignore). Aquí no hay secretos: sólo identificadores.

# La identidad que ejecuta Terraform sale de la cadena ambiental de credenciales
# y se valida contra aws_account_id con data.aws_caller_identity.current.
aws_account_id = "133789123239"
aws_region     = "eu-north-1"
vpc_id         = "vpc-023864c0ca3c82eab"
subnet_id      = "subnet-0bb97e6254e4f83e9"

# Etiquetas administradas por un sistema corporativo externo. Terraform las
# ignora (`ignore_tags` del provider) para no eliminarlas al actualizar recursos:
# no conoce ni gestiona sus valores. Fuera de ese entorno el valor es [].
# En la cuenta corporativa de la PoC:
#   externally_managed_tag_keys = [
#     "APPID", "BILLINGCODE", "BILLINGCONTACT", "BUSINESSAREA", "CMS",
#     "COUNTRY", "CSCLASS", "CSQUAL", "CSTYPE", "ENVIRONMENT", "FUNCTION",
#     "GROUPCONTACT", "MEMBERFIRM", "PRIMARYCONTACT", "SECONDARYCONTACT",
#   ]
# Name, PatchGroup y las etiquetas msr-* siguen bajo control de Terraform y no
# pueden incluirse en esta lista.
externally_managed_tag_keys = []

# Proceso Launch del ASG. Operación normal: el grupo lanza la instancia.
#   asg_launch_suspended = false
# Recuperación/contención temporal (el grupo no lanza nada):
#   asg_launch_suspended = true
# Volver a false sólo con un plan revisado, cuando el Launch Template, el
# instance profile y las etiquetas ya estén corregidos.
asg_launch_suspended = false

# Instance profile corporativo preexistente: la cuenta deniega la creación de
# roles y políticas propios, así que Terraform sólo lo lee.
existing_instance_profile_name      = "EC2SSMAgentProfileL0"
existing_instance_profile_role_name = "EC2SSMAgentProfile"

lab_id             = "linux-patching-01"
source_ami_id      = "ami-0b2ab3a97a77bd35e" # al2023-ami-2023.11.20260509.0-kernel-6.1-x86_64
source_ami_release = "2023.11.20260509.0"
instance_type      = "t3.micro"

# El advisory debe corregirse en una release POSTERIOR a la de la AMI base; si no,
# la instancia nace ya parcheada y la PoC no puede demostrar nada.
candidate_advisory_id    = "ALAS2023-2026-1924"
candidate_releasever     = "2023.12.20260706"
expected_fixed_kernel    = "6.1.176-220.358.amzn2023.x86_64"
candidate_package_family = "kernel"

# Nunca 0.0.0.0/0: la PoC no abre ningún puerto de entrada.
allowed_ui_cidr = "10.0.0.0/8"

# Interruptor maestro. Con `false` el plan queda vacío y no se crea nada.
enable_real_resources = false

# --- Runtime del backend (ECS Fargate) ---------------------------------------
# Con `false` el plan contiene únicamente los recursos del laboratorio.
enable_backend_service = false

# A) Si la cuenta permite crear IAM, Terraform crea el Task Role y su política:
#   create_backend_task_role = true
#
# B) Si la creación de IAM está denegada, el equipo corporativo de cloud
#    aprovisiona los roles con los documentos exactos de los outputs
#    backend_task_role_trust_policy_json y backend_task_role_permission_policy_json,
#    y aquí sólo se consumen sus ARNs:
#   create_backend_task_role   = false
#   backend_task_role_arn      = "arn:aws:iam::133789123239:role/<rol-corporativo>"
#   backend_execution_role_arn = "arn:aws:iam::133789123239:role/<rol-exec-corporativo>"
create_backend_task_role = false

# Imagen publicada en ECR y subnets privadas de la task (sin IP pública).
# backend_image      = "133789123239.dkr.ecr.eu-north-1.amazonaws.com/msr-platform:0.1.0"
# backend_subnet_ids = ["subnet-0bb97e6254e4f83e9"]

# MSR_DRY_RUN en la task: se mantiene en true hasta la autorización explícita.
backend_dry_run = true

# --- Registro de imágenes (ECR) ----------------------------------------------
# Repositorio privado con escaneo, cifrado y lifecycle policy corta.
enable_backend_ecr = false
# backend_ecr_repository_name = "msr-poc-platform"
# backend_ecr_retained_images = 5

# --- Exposición de la UI/API (ALB) -------------------------------------------
# cliente → ALB → ECS Fargate :8080 (health check /api/health).
# El backend sólo acepta tráfico del security group del ALB.
enable_backend_alb = false
# Interno por defecto: no se asume que la red corporativa permita un ALB público.
backend_alb_internal = true
# Al menos dos subnets en zonas distintas (privadas si el ALB es interno).
# backend_alb_subnet_ids = ["subnet-0bb97e6254e4f83e9", "subnet-0aa97e6254e4f83e0"]
# Sin orígenes declarados no se crea ninguna regla de entrada.
# backend_alb_ingress_cidrs = ["10.0.0.0/16"]

# --- Lock distribuido del laboratorio (DynamoDB) -----------------------------
# Obligatorio antes de la ejecución real: serializa patch, reset y la
# reconciliación de release entre la task del servicio y el RunTask del hook.
enable_backend_lock_table = false
# backend_lock_table_name = "msr-poc-lab-locks"
