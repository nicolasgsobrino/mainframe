# Configuración de la plataforma MSR (copiar a .env y ajustar).
# NO contiene valores reales ni credenciales. Las credenciales de AWS se
# resuelven mediante la cadena estándar del SDK (perfil, rol o variables del
# entorno de ejecución): la aplicación NUNCA las lee de estas variables.

# --- Providers ---------------------------------------------------------------
# mock | aws-automation
MSR_PATCH_PROVIDER=mock
MSR_RESTORE_PROVIDER=mock
# Con true no se invoca ninguna API mutativa de AWS.
MSR_DRY_RUN=true

# --- Persistencia de jobs ----------------------------------------------------
MSR_JOBS_DB_PATH=./data/msr_jobs.db

# --- AWS (vacío = desactivado) ----------------------------------------------
# Región y cuenta de la PoC (ver infra/terraform). Los ARNs se rellenan con los
# outputs de Terraform DESPUÉS del apply: aquí se dejan vacíos a propósito.
MSR_AWS_REGION=eu-north-1
MSR_AWS_ROLE_ARN=
MSR_AWS_PROFILE=
MSR_AWS_ENDPOINT_URL=

# --- Systems Manager Automation ---------------------------------------------
# Runbooks PROPIOS de tipo Automation. Un documento de tipo Command (por ejemplo
# AWS-RunPatchBaseline) no puede iniciarse con StartAutomationExecution: el
# runbook propio lo invoca internamente con aws:runCommand.
MSR_PATCH_RUNBOOK_NAME=MSR-PatchLinuxInstance
MSR_ROLLBACK_RUNBOOK_NAME=MSR-RollbackLinuxInstance
MSR_RESET_RUNBOOK_NAME=MSR-ResetLabInstance
# No existe variable de service role: los runbooks no declaran `assumeRole` ni
# admiten AutomationAssumeRole. La Automation se ejecuta siempre con la identidad
# que la inicia (en el despliegue, el ECS Task Role del backend).

# --- Laboratorio reseteable --------------------------------------------------
# Ninguna variable puede fijar un Instance ID: el descubrimiento por tags es la
# única fuente de verdad (MSR_SANDBOX_INSTANCE_ID ya no existe), porque cada
# reset recrea la instancia con un identificador distinto.
MSR_LAB_LOGICAL_ID=linux-patching-01
MSR_LAB_TAG_KEY=msr-lab-id
MSR_LAB_ENVIRONMENT=sandbox
MSR_PATCH_ADVISORY_ID=ALAS2023-2026-1924
MSR_PATCH_PACKAGE_FAMILY=kernel
# El repositorio de la AMI base está fijado en su release (2023.11.20260509.0),
# anterior a la corrección: precheck, postcheck y reset consultan el advisory con
# `dnf --releasever`. Valor de la IaC; el frontend sólo puede mostrarlo.
MSR_PATCH_RELEASEVER=2023.12.20260706
MSR_PATCH_EXPECTED_FIXED_KERNEL=6.1.176-220.358.amzn2023.x86_64
# Launch Template del laboratorio (informativo: lo consume el ASG, no el
# runbook). Se rellena con los outputs de Terraform; versión fija, nunca $Latest.
MSR_LAB_LAUNCH_TEMPLATE_ID=
MSR_LAB_LAUNCH_TEMPLATE_VERSION=
# Auto Scaling Group de capacidad fija 1 que mantiene viva la instancia. El reset
# la sustituye dentro de este grupo; el valor sale de la IaC y nunca de la API.
MSR_LAB_AUTOSCALING_GROUP_NAME=

# --- Reconciliación del laboratorio (ensure_lab_ready, fase 2.6) -------------
# Desactivada al arrancar: un reinicio de worker no debe recrear la instancia.
# El hook de despliegue de ejecución única es `python -m app.lab_hook`
# (añade --confirm para autorizar la recreación real en modo aws-real).
MSR_LAB_RECONCILE_ON_STARTUP=false
MSR_LAB_RECONCILE_LOCK_TTL_SECONDS=1800
MSR_LAB_RECONCILE_TIMEOUT_SECONDS=1800
MSR_LAB_RECONCILE_POLL_INTERVAL_SECONDS=15
MSR_LAB_REPLACEMENT_TIMEOUT_SECONDS=900

# --- Política de objetivos ---------------------------------------------------
# Listas separadas por comas.
MSR_ALLOWED_ACCOUNT_IDS=133789123239
MSR_ALLOWED_REGIONS=eu-north-1
MSR_ALLOWED_ENVIRONMENTS=sandbox
MSR_ALLOWED_RUNBOOKS=MSR-PatchLinuxInstance,MSR-RollbackLinuxInstance,MSR-ResetLabInstance
MSR_REQUIRED_TARGET_TAG_KEY=msr-poc
MSR_REQUIRED_TARGET_TAG_VALUE=true

# --- Jobs --------------------------------------------------------------------
MSR_JOB_POLL_INTERVAL_SECONDS=2
MSR_JOB_TIMEOUT_SECONDS=1800
# Reconciliador periódico de jobs activos (no ejecuta parches, sólo consulta).
MSR_RECONCILER_ENABLED=true
MSR_RECONCILER_INTERVAL_SECONDS=10
MSR_MOCK_JOB_DURATION_SECONDS=6
MSR_MOCK_RESTORE_DURATION_SECONDS=0
MSR_MAX_OUTPUT_CHARS=2000

# --- API ---------------------------------------------------------------------
# Nunca "*" fuera de desarrollo local.
MSR_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
