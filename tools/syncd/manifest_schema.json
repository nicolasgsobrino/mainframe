{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "syncd/manifest_schema.json",
  "title": "SYNC-MANIFEST schema",
  "description": "JSON Schema for SYNC-MANIFEST.yaml (syncd v1)",
  "type": "object",
  "required": ["schema_version", "programs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "syncd/1"
    },
    "verify_targets": {
      "type": "object",
      "description": "Optional baseline targets checked by sync.py verify",
      "additionalProperties": false,
      "properties": {
        "gate_pass_count":  { "type": "integer", "minimum": 0 },
        "lint_errors":      { "type": "integer", "minimum": 0 },
        "lint_warnings":    { "type": "integer", "minimum": 0 },
        "lint_files":       { "type": "integer", "minimum": 0 }
      }
    },
    "programs": {
      "type": "object",
      "description": "Per-program locked state. Keys are program IDs (e.g. CBSTM03A).",
      "additionalProperties": {
        "type": "object",
        "required": ["locked_numbers", "locked_at"],
        "additionalProperties": true,
        "properties": {
          "locked_at": {
            "type": "string",
            "description": "ISO 8601 UTC timestamp of last lock"
          },
          "locked_numbers": {
            "type": "object",
            "required": [
              "paragraphs_expected",
              "l01_items_expected",
              "reachable_expected",
              "dead_paragraphs_allowed"
            ],
            "additionalProperties": true,
            "properties": {
              "paragraphs_expected":     { "type": "integer", "minimum": 0 },
              "l01_items_expected":      { "type": "integer", "minimum": 0 },
              "reachable_expected":      { "type": "integer", "minimum": 0 },
              "dead_paragraphs_allowed": { "type": "integer", "minimum": 0 },
              "source_sha": {
                "type": ["string", "null"],
                "description": "SHA of the .cbl source file at lock time"
              },
              "cfg_sha": {
                "type": ["string", "null"],
                "description": "git hash-object SHA of the _cfg.json at lock time"
              }
            }
          }
        }
      }
    }
  }
}
